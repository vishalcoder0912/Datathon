# KAVACH AI local prototype. Copy to .env for a local-only deployment.
# No paid AI, map, geocoding, authentication, or database service is required.

PORT=3001
HOST=127.0.0.1
NODE_ENV=development

# PostgreSQL + PostGIS
POSTGRES_DB=kavach
POSTGRES_USER=kavach
POSTGRES_PASSWORD=kavach_local_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql://kavach:kavach_local_password@localhost:5432/kavach
DATABASE_POOL_MAX=10
DATABASE_POOL_MIN=0
DATABASE_SSL=false
KAVACH_DATA_SOURCE=postgres
# Set true only when deliberately using the documented offline file fallback.
KAVACH_FILE_DEMO_FALLBACK=false

# Local JWT authentication. Generate long random values for any shared deployment.
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SAME_SITE=lax
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_CREDENTIALS=true
SEED_ADMIN_NAME=KAVACH Administrator
SEED_ADMIN_EMAIL=admin@kavach.local
# Required by `npm run db:seed`; do not commit a real password.
SEED_ADMIN_PASSWORD=

# Local Ollama is optional. The approved deterministic KAVACH tool router works if it is absent.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_FALLBACK_MODEL=llama3.2:3b

# Python analytics service
ML_SERVICE_URL=http://localhost:5000
ML_SERVICE_TIMEOUT_MS=30000
ML_ANALYTICS_CACHE_TTL_MS=600000
ML_ANALYTICS_CACHE_MAX_ENTRIES=500

# Frontend
VITE_API_URL=http://localhost:3001
VITE_AUTH_REQUIRED=true

# Request and import guardrails
MAX_JSON_BODY_BYTES=20971520
