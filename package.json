{
  "name": "insightflow",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/frontend",
    "apps/backend",
    "packages/shared-analytics",
    "packages/kavach-domain"
  ],
  "scripts": {
    "dev": "npm run seed:kavach && concurrently --kill-others --names backend,frontend --prefix-colors cyan,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:all": "npm run dev",
    "dev:frontend": "npm run dev -w apps/frontend",
    "dev:backend": "npm run dev -w apps/backend",
    "dev:ml": "python -m uvicorn app.main:app --host 127.0.0.1 --port 5000 --workers 1 --app-dir apps/ml-service",
    "dev:full": "concurrently --kill-others \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:ml\"",
    "db:up": "docker compose -f infra/docker-compose.yml up -d postgres",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "node apps/backend/scripts/migrate.js",
    "db:seed": "node apps/backend/scripts/seed.js",
    "db:reset": "node apps/backend/scripts/reset-database.js",
    "db:migrate-demo": "node scripts/migrate-kavach-demo-to-postgres.mjs",
    "build": "npm run build -w apps/frontend",
    "build:frontend": "npm run build -w apps/frontend",
    "build:backend": "npm run build -w apps/backend",
    "export:ai-safe": "node scripts/export-ai-safe.js",
    "export:onefile": "node scripts/export-full-codebase-one-file.js",
    "export:codebase": "node scripts/generate-codebase-export.mjs",
    "export:watch": "node scripts/watch-and-export-codebase.mjs",
    "lint": "npm run lint -w apps/frontend",
    "test": "npm run test -w apps/frontend",
    "test:backend": "npm run test:run -w apps/backend",
    "test:frontend": "npm run test -w apps/frontend",
    "test:a11y": "npx playwright test --project=e2e-a11y",
    "test:visual": "percy exec -- npx playwright test --project=e2e-core",
    "test:extreme": "npm run test:extreme -w apps/frontend",
    "test:frontend:full": "npm run test:frontend:full -w apps/frontend",
    "test:cross-browser": "npx playwright test --project=chromium --project=firefox --project=webkit --project=chrome-android --project=safari-ios --project=msedge",
    "percy": "percy exec -- npx playwright test src/__tests__/visual/",
    "test:integration": "npm run test:run -w apps/backend -- src/__tests__/integration",
    "test:integration:supertest": "npm run test:integration:supertest -w apps/backend",
    "test:database": "npm run test:database -w apps/backend",
    "test:backend:full": "npm run test:run -w apps/backend",
    "test:mutation": "stryker run stryker.conf.js",
    "test:e2e:kavach": "node scripts/run-kavach-e2e.mjs",
    "test:e2e": "npx playwright test --project=e2e-core",
    "test:e2e:extreme": "npx playwright test --project=e2e-extreme",
    "test:api:newman": "node postman/run-newman.mjs",
    "test:full": "npx playwright test --project=e2e-core && npx playwright test --project=e2e-extreme && npx playwright test --project=e2e-a11y",
    "qa:report": "node tools/qa/generate-final-qa-report.mjs",
    "test:ai": "vitest run -w apps/backend apps/backend/src/__tests__/ai-provider-router.test.js",
    "test:rag": "vitest run -w apps/backend apps/backend/src/__tests__/rag-retrieval.test.js",
    "test:guardian": "vitest run -w apps/backend apps/backend/src/__tests__/dashboard-guardian.test.js",
    "test:insightflow-api": "node scripts/verify-insightflow-backend.mjs",
    "test:pipeline": "node scripts/run-production-test-pipeline.mjs",
    "doctor": "npx react-doctor@latest",
    "audit:code": "node scripts/audit-codebase.js",
    "seed:kavach": "node scripts/seed-kavach.mjs",
    "test:security": "vitest run -w apps/backend apps/backend/src/__tests__/security",
    "audit:npm": "npm audit --audit-level=high || true",
    "audit:gitleaks": "gitleaks detect --source . --no-git --verbose || echo 'gitleaks: install from https://github.com/gitleaks/gitleaks'",
    "audit:trivy": "trivy fs --scanners vuln,secret --ignorefile .trivyignore . || echo 'trivy: install from https://github.com/aquasecurity/trivy'",
    "audit:full": "npm run audit:npm && npm run audit:gitleaks && npm run audit:trivy",
    "security:ci": "npm run test:security && npm run audit:full",
    "docker:build": "docker compose -f docker-compose.full.yml build",
    "docker:up": "docker compose -f docker-compose.full.yml up -d",
    "docker:down": "docker compose -f docker-compose.full.yml down",
    "docker:scan": "trivy image insightflow-backend:latest && trivy image insightflow-frontend:latest && trivy image insightflow-ml-service:latest",
    "deploy:catalyst": "node scripts/deploy-catalyst.mjs",
    "deploy:smoke-test": "node scripts/health-check.mjs --smoke",
    "ci:full": "npm run lint && npm run test -w apps/frontend && npm run test:run -w apps/backend && npm run test:integration",
    "test:perf": "vitest run -w apps/backend apps/backend/src/__tests__/performance",
    "test:load:k6": "node k6/run-k6.mjs",
    "test:stress:artillery": "node -e \"const { execSync } = require('child_process'); process.exit(execSync('artillery run artillery/stress-auth.yml && artillery run artillery/stress-api.yml && artillery run artillery/stress-ai.yml', { stdio: 'inherit', shell: true }).status || 0);\"",
    "test:lighthouse": "lhci autorun",
    "perf:budget": "node scripts/validate-perf-budget.mjs",
    "test:all:perf": "npm run test:perf && npm run perf:budget",
    "test:docker": "scripts\\test-docker.bat",
    "test:docker:unit": "scripts\\test-docker.bat unit",
    "test:docker:e2e": "scripts\\test-docker.bat e2e",
    "test:docker:up": "scripts\\test-docker.bat up",
    "test:docker:down": "scripts\\test-docker.bat down",
    "test:docker:clean": "scripts\\test-docker.bat clean"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@percy/cli": "^1.32.4",
    "@percy/playwright": "^1.1.1",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "newman": "^6.2.2",
    "newman-reporter-htmlextra": "^1.23.1",
    "react-doctor": "^0.2.13",
    "supertest": "^7.2.2"
  },
  "dependencies": {
    "@qdrant/js-client-rest": "^1.15.1",
    "@types/react-simple-maps": "^3.0.6",
    "@types/topojson-client": "^3.1.5",
    "ecc-universal": "^2.0.0",
    "react-simple-maps": "^3.0.0",
    "topojson-client": "^3.1.0"
  }
}
