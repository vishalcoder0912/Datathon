    {
      "name": "Datasets",
      "item": [
        {
          "name": "List Datasets",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Lists datasets', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  if (json.data && json.data.datasets && json.data.datasets.length > 0) {",
                  "    pm.collectionVariables.set('datasetId', json.data.datasets[0].id);",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/datasets",
              "host": ["{{baseUrl}}"],
              "path": ["api", "datasets"]
            }
          }
        },
        {
          "name": "Import Dataset (CSV)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Dataset imported', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  if (json.data && json.data.dataset && json.data.dataset.id) {",
                  "    pm.collectionVariables.set('datasetId', json.data.dataset.id);",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "sample.csv"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/datasets/import",
              "host": ["{{baseUrl}}"],
              "path": ["api", "datasets", "import"]
            }
          }
        },
        {
          "name": "Get Dataset by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/datasets/{{datasetId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "datasets", "{{datasetId}}"]
            }
          }
        },
        {
          "name": "Delete Dataset",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/datasets/{{datasetId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "datasets", "{{datasetId}}"]
            }
          }
        }
      ]
