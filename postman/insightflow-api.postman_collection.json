{
  "info": {
    "name": "InsightFlow API",
    "description": "Complete API collection for InsightFlow — AI-powered data analytics platform with KAVACH AI crime analytics",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "insightflow-qa"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
