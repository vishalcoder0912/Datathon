FROM node:20-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/backend/package.json ./apps/backend/
COPY apps/frontend/package.json ./apps/frontend/
COPY packages/shared-analytics/package.json ./packages/shared-analytics/
COPY packages/kavach-domain/package.json ./packages/kavach-domain/
RUN npm ci --omit=dev --ignore-scripts

FROM node:20-slim AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/package.json ./
COPY --from=deps /app/package-lock.json ./
COPY package.json package-lock.json ./
COPY apps/backend ./apps/backend
COPY packages ./packages
RUN node --check apps/backend/src/index.js

FROM node:20-slim
RUN groupadd -r appgroup && useradd -r -g appgroup -d /app -s /sbin/nologin appuser
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./
COPY --from=build /app/apps/backend ./apps/backend
COPY --from=build /app/packages ./packages
ENV NODE_ENV=production
ENV PORT=3001
EXPOSE 3001
USER appuser
HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=5 \
  CMD node -e "require('http').get('http://localhost:3001/api/health', r => {process.exit(r.statusCode!==200?1:0)}).on('error',()=>process.exit(1))"
STOPSIGNAL SIGTERM
CMD ["node", "apps/backend/src/index.js"]
