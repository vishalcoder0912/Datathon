def mlPython() {
    return 'C:\\Users\\VISHAL\\AppData\\Local\\Python\\bin\\python.exe'
}

pipeline {
    agent any

    options {
        timestamps()
        timeout(time: 60, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(
            numToKeepStr: '10',
            artifactNumToKeepStr: '5'
        ))
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                bat 'npm ci'
            }
        }

        stage('Lint') {
            steps {
                bat 'npm run lint'
            }
        }

        stage('Build') {
            parallel {
                stage('Frontend Build') {
                    steps {
                        bat 'npm run build'
                    }
                }
                stage('Backend Build') {
                    steps {
                        bat 'npm run build:backend'
                    }
                }
            }
        }

        stage('Unit Tests') {
            parallel {
                stage('Frontend Tests') {
                    steps {
                        bat 'npm run test:frontend'
                    }
                }
                stage('Backend Tests') {
                    steps {
                        bat 'npm run test:backend'
                    }
                }
            }
        }

        stage('Integration Tests') {
            steps {
                bat 'npm run test:integration'
            }
        }
    }

    post {
        always {
            junit allowEmptyResults: true, testResults: '**/test-results/*.xml, **/coverage/*.xml'
            archiveArtifacts artifacts: 'apps/frontend/dist/**', allowEmptyArchive: true
        }
        success {
            echo 'Build passed.'
        }
        failure {
            echo 'Build failed. See test reports and logs.'
        }
    }
}