pipeline {
    agent any

    options {
        timestamps()
        timeout(time: 60, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    environment {
        // Override with Jenkins credentials where required, e.g.
        // OPENAI_API_KEY = credentials('openai-api-key')
        PLAYWRIGHT_BASE_URL = 'http://127.0.0.1:45173'
    }

    parameters {
        booleanParam(name: 'RUN_E2E', defaultValue: false, description: 'Run Playwright end-to-end tests (requires services)')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('repo') {
                    sh 'npm ci'
                    sh 'python -m venv .venv && .venv/bin/pip install -r apps/ml-service/requirements.txt'
                }
            }
        }

        stage('Lint & Typecheck') {
            steps {
                dir('repo') {
                    sh 'npm run lint'
                    sh 'npm run typecheck'
                }
            }
        }

        stage('Unit Tests') {
            parallel {
                stage('Frontend') {
                    steps {
                        dir('repo') {
                            sh 'npm run test -w apps/frontend'
                        }
                    }
                }
                stage('Backend') {
                    steps {
                        dir('repo') {
                            sh 'npm run test:run -w apps/backend'
                            sh 'npm run test:integration'
                        }
                    }
                }
                stage('ML Service') {
                    steps {
                        dir('repo') {
                            sh '.venv/bin/python -m pytest apps/ml-service -q'
                        }
                    }
                }
            }
        }

        stage('Security Checks') {
            steps {
                dir('repo') {
                    sh 'npm run test:security || true'
                    sh 'npm run audit:npm'
                }
            }
        }

        stage('Build') {
            parallel {
                stage('Frontend Build') {
                    steps {
                        dir('repo') {
                            sh 'npm run build'
                        }
                    }
                }
                stage('Backend Build') {
                    steps {
                        dir('repo') {
                            sh 'npm run build:backend'
                        }
                    }
                }
            }
        }

        stage('E2E Tests') {
            when { expression { return params.RUN_E2E } }
            steps {
                dir('repo') {
                    sh 'npm run test:e2e'
                }
            }
        }
    }

    post {
        always {
            junit allowEmptyResults: true, testResults: 'repo/**/test-results/*.xml, repo/**/coverage/*.xml'
            archiveArtifacts artifacts: 'repo/apps/frontend/dist/**', allowEmptyArchive: true
        }
        success {
            echo 'Build passed.'
        }
        failure {
            echo 'Build failed. See test reports and logs.'
        }
    }
}
