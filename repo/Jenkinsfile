pipeline {
    agent any

    options {
        timestamps()
        timeout(time: 60, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(
            numToKeepStr: '10',
            artifactNumToKeepStr: '5'
        ))
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('repo') {
                    bat 'npm ci'
                }
            }
        }

        stage('Lint') {
            steps {
                dir('repo') {
                    bat 'npm run lint'
                }
            }
        }

        stage('Build') {
            parallel {
                stage('Frontend Build') {
                    steps {
                        dir('repo') {
                            bat 'npm run build'
                        }
                    }
                }
                stage('Backend Build') {
                    steps {
                        dir('repo') {
                            bat 'npm run build:backend'
                        }
                    }
                }
            }
        }

        stage('Unit Tests') {
            parallel {
                stage('Frontend Tests') {
                    steps {
                        dir('repo') {
                            bat 'npm run test:frontend'
                        }
                    }
                }
                stage('Backend Tests') {
                    steps {
                        dir('repo') {
                            bat 'npm run test:backend'
                        }
                    }
                }
            }
        }

        stage('Integration Tests') {
            steps {
                dir('repo') {
                    bat 'npm run test:integration'
                }
            }
        }
    }

    post {
        always {
            junit allowEmptyResults: true, testResults: 'repo/**/test-results/*.xml, repo/**/coverage/*.xml'
            archiveArtifacts artifacts: 'repo/apps/frontend/dist/**', allowEmptyArchive: true
        }
        success {
            echo 'Build passed.'
        }
        failure {
            echo 'Build failed. See test reports and logs.'
        }
    }
}