{
  "__inputs": [],
  "__requires": [],
  "title": "InsightFlow Application",
  "uid": "insightflow-app",
  "version": 1,
  "schemaVersion": 39,
  "tags": ["insightflow", "kavach"],
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "API Requests",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(http_requests_total[5m])",
          "legendFormat": "{{method}} {{route}}",
          "refId": "A"
        }
      ],
      "description": "HTTP request rate per route"
    },
    {
      "id": 2,
      "title": "Request Latency (p95)",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, route))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "description": "95th percentile request latency"
    },
    {
      "id": 3,
      "title": "Error Rate",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "rate(http_requests_total{status=~\"5..\"}[5m]) / rate(http_requests_total[5m])",
          "legendFormat": "error rate",
          "refId": "A"
        }
      ],
      "description": "Proportion of 5xx responses"
    },
    {
      "id": 4,
      "title": "Active Users",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(active_users_total[5m]))",
          "legendFormat": "active users",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Database Connections",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "pg_stat_database_numbackends",
          "legendFormat": "{{datname}}",
          "refId": "A"
        }
      ],
      "description": "Active PostgreSQL connections"
    },
    {
      "id": 6,
      "title": "Memory Usage",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "process_resident_memory_bytes{job=\"insightflow-backend\"}",
          "legendFormat": "backend",
          "refId": "A"
        },
        {
          "expr": "process_resident_memory_bytes{job=\"insightflow-ml-service\"}",
          "legendFormat": "ml-service",
          "refId": "B"
        }
      ],
      "description": "Resident memory per service"
    },
    {
      "id": 7,
      "title": "CPU Usage",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total[5m])",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "AI API Latency",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ai_provider_request_duration_seconds_bucket[5m])) by (le, provider))",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ],
      "description": "AI provider p95 latency"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "query": "label_values(up, instance)",
        "refresh": 1,
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Deployments",
        "type": "dashboard",
        "builtIn": 0,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": false,
        "iconColor": "rgba(255, 96, 96, 1)",
        "expr": "",
        "showIn": 0
      }
    ]
  },
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h"] }
}
